# Shared-collection pattern (single cluster, single database)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/appdb?retryWrites=true&w=majority

# Database-per-tenant pattern (same cluster, one logical database per tenant)
# The tenant-specific db name is appended at connection time — see src/patterns/db-per-tenant
MONGO_BASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

PORT=3000
